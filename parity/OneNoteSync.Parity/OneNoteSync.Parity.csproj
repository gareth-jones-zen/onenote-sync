<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET side of the parity checks (parity/parity.py), published with Native AOT so the checks run on what
       ships, not the test build. Reads only the parity folder; no Graph, no settings, no state but its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>onenote-sync-parity</AssemblyName>
    <RootNamespace>OneNoteSync.Parity</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\OneNoteSync\OneNoteSync.csproj" />
    <Compile Include="..\..\tests\OneNoteSync.Tests\FakeNotebook.cs" Link="FakeNotebook.cs" />
  </ItemGroup>
</Project>
